<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NINA.Equipment (rig subset) on macOS:
    - Mac/: the include list's merge guards (packages against NINA.Equipment.csproj, the compiled assembly's references and
      native imports, legacy-encoded literals), the ZWO binding through the resolver, the vendor-free device choosers,
      DirectGuider dithering through the telescope mediator, and the headless capture path with a stand-in camera.
      AsiCameraHardwareTest is [Explicit] (Category Hardware): it needs the ZWO ASI585MC Pro and never runs by default.
    - Upstream/: upstream NINA.Test fixtures, linked unchanged, that need only the kept NINA.Equipment files plus Core, Profile,
      Astrometry and Image. See ../../src/README-engine.md (NINA.Equipment).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>NINA.Mac.Equipment.Test</RootNamespace>
    <!-- NINA.Equipment.Mac's Mac/AssemblyInfo.Mac.cs grants this assembly name access to internals, as upstream grants NINA.Test -->
    <AssemblyName>NINA.Mac.Equipment.Test</AssemblyName>
    <!-- As NINA.Test.csproj, so the linked upstream fixtures compile exactly as they do on Windows -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="[7.0.0]" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/NINA.Mac.Native/NINA.Mac.Native.csproj" />
    <ProjectReference Include="../../src/NINA.Mac.WpfCompat/NINA.Mac.WpfCompat.csproj" />
    <ProjectReference Include="../../src/NINA.Core.Mac/NINA.Core.Mac.csproj" />
    <ProjectReference Include="../../src/NINA.Profile.Mac/NINA.Profile.Mac.csproj" />
    <ProjectReference Include="../../src/NINA.Astrometry.Mac/NINA.Astrometry.Mac.csproj" />
    <ProjectReference Include="../../src/Accord.Imaging.Mac/Accord.Imaging.Mac.csproj" />
    <ProjectReference Include="../../src/NINA.Image.Mac/NINA.Image.Mac.csproj" />
    <ProjectReference Include="../../src/NINA.Equipment.Mac/NINA.Equipment.Mac.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NinaRoot</_Parameter1>
      <_Parameter2>$(NinaRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    The independent FITS reader written for NINA.Mac.Image.Test (from the FITS 4.0 standard, no NINA code), linked rather than
    copied: the hardware test reads its frame back with it.
  -->
  <ItemGroup>
    <Compile Include="../NINA.Mac.Image.Test/Mac/FitsFile.cs" Link="Shared/FitsFile.cs" />
  </ItemGroup>

  <!-- Upstream NINA.Test fixtures, linked unchanged -->
  <PropertyGroup>
    <UpstreamTests>$(NinaRoot)NINA.Test/</UpstreamTests>
  </PropertyGroup>
  <ItemGroup>
    <!-- global using NUnit.Framework, plus the SetUpFixture that preloads the natives (DllLoader is a no-op off Windows) -->
    <Compile Include="$(UpstreamTests)Usings.cs" Link="Upstream/Usings.cs" />

    <Compile Include="$(UpstreamTests)CaptureSequenceTest.cs" Link="Upstream/CaptureSequenceTest.cs" />
    <Compile Include="$(UpstreamTests)GuideStepsHistoryTest.cs" Link="Upstream/GuideStepsHistoryTest.cs" />
    <Compile Include="$(UpstreamTests)ImageMetaDataTest.cs" Link="Upstream/ImageMetaDataTest.cs" />
    <Compile Include="$(UpstreamTests)Equipment/CaptureSequenceBehaviorTest.cs" Link="Upstream/Equipment/CaptureSequenceBehaviorTest.cs" />
    <Compile Include="$(UpstreamTests)Equipment/DeviceContractBehaviorTest.cs" Link="Upstream/Equipment/DeviceContractBehaviorTest.cs" />
    <Compile Include="$(UpstreamTests)Equipment/DirectGuiderTest.cs" Link="Upstream/Equipment/DirectGuiderTest.cs" />
    <Compile Include="$(UpstreamTests)Equipment/EquipmentInfoBehaviorTest.cs" Link="Upstream/Equipment/EquipmentInfoBehaviorTest.cs" />
    <Compile Include="$(UpstreamTests)Equipment/GuiderModelBehaviorTest.cs" Link="Upstream/Equipment/GuiderModelBehaviorTest.cs" />
    <Compile Include="$(UpstreamTests)Equipment/ImageMetaDataExtensionBehaviorTest.cs" Link="Upstream/Equipment/ImageMetaDataExtensionBehaviorTest.cs" />
  </ItemGroup>

</Project>
