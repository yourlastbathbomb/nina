<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TEST-ONLY reference oracle (never shipped). Compiles the in-repo upstream Accord.Imaging sources (LGPL, the exact
    code Windows N.I.N.A. links) plus NINA's BayerFilter16bpp / NoBlurCannyEdgeDetector by link, so the managed ports in
    mac/src/NINA.Mac.ImageAnalysis can be compared bit-for-bit against the original filters on macOS. Only the
    UnmanagedImage code paths are used: anything that touches GDI+ (Bitmap, Graphics) throws on macOS.
    The upstream files are not modified; warnings in this third-party code are not ours and are silenced.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RuntimeIdentifier></RuntimeIdentifier>
    <AssemblyName>Accord.Imaging</AssemblyName>
    <RootNamespace>Accord.Imaging</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <WarningLevel>0</WarningLevel>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0419;CS0612;CS0618;CS0649;CS0659;CS0661;CS1570;CS1572;CS1573;CS1574;CS1580;CS1584;CS1587;CS1591;CS1658;CS1711;CS1734;CS8073;CA1416;NU1701;NU1702;NU1603</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(NinaRoot)Accord.Imaging/**/*.cs" Exclude="$(NinaRoot)Accord.Imaging/obj/**;$(NinaRoot)Accord.Imaging/bin/**" LinkBase="Accord.Imaging" />
    <Compile Include="$(NinaRoot)NINA.Image/ImageAnalysis/BayerFilter16bpp.cs" Link="NINA/BayerFilter16bpp.cs" />
    <Compile Include="$(NinaRoot)NINA.Image/ImageAnalysis/NoBlurCannyEdgeDetector.cs" Link="NINA/NoBlurCannyEdgeDetector.cs" />
    <Compile Include="$(NinaRoot)NINA.Image/ImageData/LRGBArrays.cs" Link="NINA/LRGBArrays.cs" />
    <Compile Include="OracleShims.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Accord" Version="3.8.2-alpha" />
    <PackageReference Include="Accord.Math" Version="3.8.2-alpha" />
    <PackageReference Include="Accord.Statistics" Version="3.8.2-alpha" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.2" />
  </ItemGroup>

</Project>
