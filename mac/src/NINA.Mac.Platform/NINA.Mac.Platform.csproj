<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS services the app needs at the scope: sleep / App Nap prevention, power source, bundle-aware resource
    paths, user data folders and display state. P/Invoke only (IOKit, CoreFoundation, CoreGraphics, libobjc); no
    engine or UI dependency.
  -->
  <PropertyGroup>
    <RootNamespace>NINA.Mac.Platform</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NINA.Mac.App.Test" />
  </ItemGroup>

</Project>
