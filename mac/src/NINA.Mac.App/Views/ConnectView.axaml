<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NINA.Mac.App.ViewModels"
             xmlns:platform="using:NINA.Mac.Platform"
             x:Class="NINA.Mac.App.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">

  <!-- Copyright © 2016 - 2026 Stefan Berg and the N.I.N.A. contributors. MPL-2.0: http://mozilla.org/MPL/2.0/ -->

  <ScrollViewer>
    <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">

      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="Start the night" Classes="h2" />
            <TextBlock Text="Connects the camera and the mount together, then starts cooling." Classes="muted" TextWrapping="Wrap" />
            <CheckBox Name="CoolAfterConnect" IsChecked="{Binding CoolAfterConnect}" Margin="0,6,0,0">
              <TextBlock>
                <Run Text="Cool to" />
                <Run Text="{Binding CoolingTarget, StringFormat='{}{0:0} °C'}" />
                <Run Text="after connecting" />
              </TextBlock>
            </CheckBox>
          </StackPanel>
          <Button Grid.Column="1" Name="StartNightButton" Classes="accent" Padding="22,12" VerticalAlignment="Center" FontSize="15"
                  Content="Connect all" Command="{Binding StartNightCommand}" IsEnabled="{Binding CanStartNight}" />
        </Grid>
      </Border>

      <!-- Optical train: sets the focal length the solver, the FITS headers and the pixel scale use -->
      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Text="Optical train" Classes="h2" />
          <RadioButton Name="TrainNative" GroupName="Train" IsChecked="{Binding UseNative}" Content="{Binding NativeTrainText}" />
          <RadioButton Name="TrainReducer" GroupName="Train" IsChecked="{Binding UseReducer}" Content="{Binding ReducerTrainText}" />
          <TextBlock Text="Pick what is fitted: plate solving takes its scale from this. The first night: the reducer (risk 4 in the plan). Focal lengths are in Settings › Optics." Classes="muted small" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Camera -->
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
          <Ellipse Classes="dot" Margin="0,0,12,0" Classes.connected="{Binding Camera.IsConnected}" Classes.busy="{Binding Camera.IsConnecting}" Classes.lost="{Binding Camera.IsLost}" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{Binding Camera.Name}" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="{Binding Camera.StateText}" Classes="muted" />
            <TextBlock Name="CameraDetail" Text="{Binding Camera.Detail}" Classes="muted small" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Name="ConnectCameraButton" Content="Connect" Command="{Binding ConnectCameraCommand}" IsVisible="{Binding !Camera.IsConnected}" />
            <Button Name="DisconnectCameraButton" Content="Disconnect" Command="{Binding DisconnectCameraCommand}" IsVisible="{Binding Camera.IsConnected}" />
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Name="ColdWarning" Margin="0,8,0,0" Classes="warn" TextWrapping="Wrap"
                     Text="{Binding ColdDisconnectWarning}" IsVisible="{Binding ColdDisconnectWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>
      </Border>

      <!-- Mount -->
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
          <Ellipse Classes="dot" Margin="0,0,12,0" Classes.connected="{Binding Mount.IsConnected}" Classes.busy="{Binding Mount.IsConnecting}" Classes.lost="{Binding Mount.IsLost}" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{Binding Mount.Name}" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="{Binding Mount.StateText}" Classes="muted" />
            <TextBlock Text="{Binding Mount.Detail}" Classes="muted small" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Name="ConnectMountButton" Content="Connect" Command="{Binding ConnectMountCommand}" IsVisible="{Binding !Mount.IsConnected}" />
            <Button Name="DisconnectMountButton" Content="Disconnect" Command="{Binding DisconnectMountCommand}" IsVisible="{Binding Mount.IsConnected}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="Serial port" VerticalAlignment="Center" Classes="muted" />
            <ComboBox Name="PortPicker" MinWidth="320" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" IsEnabled="{Binding Mount.IsDisconnected}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="platform:SerialPortInfo">
                  <TextBlock Text="{Binding Path}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Rescan" Command="{Binding RefreshPortsCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Focuser -->
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*">
          <Ellipse Classes="dot" Margin="0,0,12,0" Classes.connected="{Binding Focuser.IsConnected}" Classes.busy="{Binding Focuser.IsConnecting}" Classes.lost="{Binding Focuser.IsLost}" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{Binding Focuser.Name}" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="{Binding Focuser.StateText}" Classes="muted" />
            <TextBlock Text="{Binding Focuser.Detail}" Classes="muted small" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Text="{Binding SimulationNote}" Classes="warn small" TextWrapping="Wrap" />

      <!-- Preflight: the same checks as the command-line preflight flag -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Preflight" Classes="h2" />
              <TextBlock Text="Daytime or dusk: bundle, solvers, index tiles, Siril, disk, battery, site, horizon, tonight's dark hours and Moon, optical train. Opens nothing unless the camera scan is ticked." Classes="muted small" TextWrapping="Wrap" />
              <CheckBox Name="PreflightWithDevices" IsChecked="{Binding PreflightWithDevices}" Content="Also look for the camera on USB (ZWO SDK scan; not while another app holds it)" />
            </StackPanel>
            <Button Grid.Column="1" Name="RunPreflightButton" Content="Run preflight" Command="{Binding RunPreflightCommand}" VerticalAlignment="Top" IsEnabled="{Binding !IsPreflightRunning}" />
          </Grid>
          <TextBlock Name="PreflightSummary" Text="{Binding PreflightSummary}" FontWeight="SemiBold" Classes.error="{Binding PreflightHasFailures}" TextWrapping="Wrap"
                     IsVisible="{Binding PreflightSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <ItemsControl Name="PreflightLines" ItemsSource="{Binding PreflightLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PreflightLineViewModel">
                <Grid ColumnDefinitions="44,*" Margin="0,3">
                  <TextBlock Text="{Binding Status}" Classes="mono" FontWeight="SemiBold" Classes.error="{Binding IsFail}" Classes.warn="{Binding IsWarn}" Classes.muted="{Binding IsOk}" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding Name}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Detail}" /></TextBlock>
                    <TextBlock Text="{Binding Fix}" Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding HasFix}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
