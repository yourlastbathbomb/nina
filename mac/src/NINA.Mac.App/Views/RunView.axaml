<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NINA.Mac.App.ViewModels"
             x:Class="NINA.Mac.App.Views.RunView"
             x:DataType="vm:RunViewModel">

  <!-- Copyright © 2016 - 2026 Stefan Berg and the N.I.N.A. contributors. MPL-2.0: http://mozilla.org/MPL/2.0/ -->

  <Grid RowDefinitions="Auto,Auto,*" MaxWidth="1100" HorizontalAlignment="Left">
    <Border Classes="card" Margin="0,0,0,14">
      <StackPanel Spacing="8">
        <TextBlock Name="PlanText" Text="{Binding PlanText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding LimitsText}" Classes="muted" TextWrapping="Wrap" />
        <TextBlock Classes="muted small" TextWrapping="Wrap">
          <Run Text="Frames go to" />
          <Run Name="OutputFolderRun" Text="{Binding OutputFolder, TargetNullValue='—'}" />
        </TextBlock>
        <TextBlock Name="PlanCheckSummary" Text="{Binding PlanCheckSummary}" Classes="muted small" TextWrapping="Wrap"
                   IsVisible="{Binding PlanCheckSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <ItemsControl Name="PlanErrors" ItemsSource="{Binding PlanErrors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding StringFormat='Plan error: {0}'}" Classes="error" TextWrapping="Wrap" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl Name="PlanWarnings" ItemsSource="{Binding PlanWarnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding StringFormat='Plan check: {0}'}" Classes="warn" TextWrapping="Wrap" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Name="CalibrationConflict" Text="{Binding CalibrationConflict}" Classes="warn" TextWrapping="Wrap"
                   IsVisible="{Binding CalibrationConflict, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
          <Button Name="StartButton" Classes="accent" Content="Start" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" Padding="20,8" />
          <Button Name="PauseButton" Content="Pause / resume" Command="{Binding PauseOrResumeCommand}" IsEnabled="{Binding IsRunning}" />
          <Button Name="StopButton" Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" Grid.Row="1" Margin="0,0,0,14">
      <Grid ColumnDefinitions="*,*,*,*">
        <StackPanel>
          <TextBlock Text="State" Classes="muted" />
          <TextBlock Name="SessionState" Text="{Binding StateText}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StopReason}" Classes="muted small" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Frames" Classes="muted" />
          <TextBlock Name="Frames" Text="{Binding FramesText}" FontSize="18" FontWeight="SemiBold" />
          <ProgressBar Value="{Binding OverallProgress}" Minimum="0" Maximum="1" Height="6" Margin="0,6,12,0" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Exposure" Classes="muted" />
          <ProgressBar Value="{Binding ExposureProgress}" Minimum="0" Maximum="1" Height="10" Margin="0,8,12,0" />
        </StackPanel>
        <StackPanel Grid.Column="3">
          <TextBlock Text="Last HFR" Classes="muted" />
          <TextBlock Text="{Binding LastHfrText}" FontSize="18" FontWeight="SemiBold" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="card" Grid.Row="2">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Log" Classes="h2" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding LastFileText}" Classes="muted small mono" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
        <ListBox Name="LogList" ItemsSource="{Binding Log}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Classes="mono" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
